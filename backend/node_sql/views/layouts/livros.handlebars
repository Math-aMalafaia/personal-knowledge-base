<h1>Meu Catálogo de Livros</h1>

<a href="/">Cadastrar livro</a>

{{#each livros}}

<div>
    <h2>{{this.nome}}</h2>

    <p>Autor: {{this.autor}}</p>
    <p>Gênero:  {{this.genero}}</p>
    <p>Status: {{this.status}}</p>
    <p>Quantidade: {{this.quantidade}}</p>

    <a href="/livros/{{this.id}}/editar">Editar</a>
    <form action="/livros/{{this.id}}/excluir" method="POST" style="display: inline;">
        <button type="submit">Excluir</button>
    </form>
</div>

<hr>

{{/each}}